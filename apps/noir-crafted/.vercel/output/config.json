{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/about/?(?:/__data.json)?$",
			"dest": "/about"
		},
		{
			"src": "^/auth/login/?(?:/__data.json)?$",
			"dest": "/auth/login"
		},
		{
			"src": "^/auth/register/?(?:/__data.json)?$",
			"dest": "/auth/register"
		},
		{
			"src": "^/careers/?(?:/__data.json)?$",
			"dest": "/careers"
		},
		{
			"src": "^/cart/?(?:/__data.json)?$",
			"dest": "/cart"
		},
		{
			"src": "^/checkout/?(?:/__data.json)?$",
			"dest": "/checkout"
		},
		{
			"src": "^/collections/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/collections/[category]"
		},
		{
			"src": "^/contact/?(?:/__data.json)?$",
			"dest": "/contact"
		},
		{
			"src": "^/cookie/?(?:/__data.json)?$",
			"dest": "/cookie"
		},
		{
			"src": "^/demo/?(?:/__data.json)?$",
			"dest": "/demo"
		},
		{
			"src": "^/faq/?(?:/__data.json)?$",
			"dest": "/faq"
		},
		{
			"src": "^/favorites/?(?:/__data.json)?$",
			"dest": "/favorites"
		},
		{
			"src": "^/homepage-template/?(?:/__data.json)?$",
			"dest": "/homepage-template"
		},
		{
			"src": "^/jxion-demo/?(?:/__data.json)?$",
			"dest": "/jxion-demo"
		},
		{
			"src": "^/privacy/?(?:/__data.json)?$",
			"dest": "/privacy"
		},
		{
			"src": "^/products/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/products/[id]"
		},
		{
			"src": "^/returns/?(?:/__data.json)?$",
			"dest": "/returns"
		},
		{
			"src": "^/shipping/?(?:/__data.json)?$",
			"dest": "/shipping"
		},
		{
			"src": "^/terms/?(?:/__data.json)?$",
			"dest": "/terms"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}