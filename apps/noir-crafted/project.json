{
  "name": "noir-crafted",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/noir-crafted/src",
  "projectType": "application",
  "tags": ["type:app", "framework:svelte"],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx svelte-kit sync",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.svelte-kit"],
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "sync"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["sync"],
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "executor": "@nx/vite:preview",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "noir-crafted:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test"
    }
  }
}
