{
  "name": "JxionWeb",
  "version": "0.0.1",
  "description": "Jxion Web Application from Jxion Team",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "nx": "npx nx",
    "graph": "npx nx graph",
    "build": "npx nx run-many --target=build --all --exclude=@jxion/angular",
    "test": "npx nx run-many --target=test --all",
    "lint": "npx nx run-many --target=lint --all",
    "serve:noir-crafted": "npx nx serve noir-crafted",
    "serve:noir-admin": "npx nx serve noir-admin",
    "serve:jxion-react": "npx nx serve jxion-react",
    "serve:noir": "concurrently \"npm run serve:noir-crafted\" \"npm run serve:noir-admin\" --names \"noir-crafted,noir-admin\" --prefix-colors \"blue,green\"",
    "build:noir-crafted": "npx nx build noir-crafted",
    "build:noir-admin": "npx nx build noir-admin",
    "build:jxion-react": "npx nx build jxion-react",
    "build:noir": "npx nx run-many --target=build --projects=noir-crafted,noir-admin --verbose"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@nx/eslint": "^19.8.4",
    "@nx/eslint-plugin": "^22.0.3",
    "@nx/js": "19.8.14",
    "@nx/react": "^19.8.4",
    "@nx/vite": "^19.8.4",
    "@nx/workspace": "^19.8.4",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "concurrently": "^5.2.0",
    "nx": "^19.8.4",
    "prettier": "^2.6.2",
    "wsrun": "^5.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "vite": "^5.4.21",
    "@sveltejs/vite-plugin-svelte": "3.1.2"
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "typescript": "~5.4.0"
  }
}
