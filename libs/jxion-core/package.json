{
  "name": "@jxion/core",
  "version": "0.1.0",
  "description": "Jxion Core - Business logic and tRPC integration",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./components": {
      "import": "./dist/src/components/index.js",
      "require": "./dist/src/components/index.js",
      "types": "./dist/src/components/index.d.ts"
    },
    "./templates": {
      "import": "./dist/src/templates/index.js",
      "require": "./dist/src/templates/index.js",
      "types": "./dist/src/templates/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/src/adapters/index.js",
      "require": "./dist/src/adapters/index.js",
      "types": "./dist/src/adapters/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@trpc/client": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "@jxion/backend": "*",
    "@jxion/i18n": "*",
    "@jxion/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
