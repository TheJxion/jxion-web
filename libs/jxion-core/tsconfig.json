{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "verbatimModuleSyntax": false,
    "composite": true,
    "downlevelIteration": true,
    "baseUrl": "../../",
    "paths": {
      "@jxion/i18n": ["libs/jxion-i18n/src/index.ts"],
      "@jxion/shared": ["libs/jxion-shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
