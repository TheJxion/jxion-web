{
  "name": "jxion-i18n",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/jxion-i18n/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:jxion-i18n"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/jxion-i18n/dist",
        "main": "libs/jxion-i18n/src/index.ts",
        "tsConfig": "libs/jxion-i18n/tsconfig.json",
        "assets": ["libs/jxion-i18n/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test"
    }
  }
}
